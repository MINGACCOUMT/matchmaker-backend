# Matchmaker Backend - 环境变量配置
# 复制此文件为 .env 并修改为你的配置

# 应用配置
APP_NAME=Matchmaker Backend
ENVIRONMENT=production
DEBUG=false
API_V1_PREFIX=/api/v1

# 数据库配置（Supabase）
# 注意：DATABASE_URL 需要在 Render Dashboard 中手动配置
# 不要在此处保存完整的数据库密码！
DATABASE_URL=postgresql://postgres:PASSWORD@db.lwormsunwjwlutwqnlnt.supabase.co:5432/postgres

# JWT 配置
SECRET_KEY=matchmaker-jwt-secret-2024-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# CORS 配置（允许的前端域名）
BACKEND_CORS_ORIGINS=["https://matchmaker-api.onrender.com", "https://matchmaker-frontend.vercel.app"]

# Supabase 配置（前端使用）
# 注意：SUPABASE_ANON_KEY 需要在 Render Dashboard 中手动配置
SUPABASE_URL=https://lwormsunwjwlutwqnlnt.supabase.co
SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
